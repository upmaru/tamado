<header class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to @item.list.project.name, project_path(@item.list.project), class: "text-sm text-base-content/60 transition-colors hover:text-base-content" %>
    <h1 class="mt-2 text-3xl font-bold tracking-tight"><%= @item.description %></h1>
    <% if @item.tags.any? %>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <% @item.taggings.includes(:tag).each do |tagging| %>
          <span class="badge badge-ghost gap-1">
            <%= link_to "##{tagging.tag.name}", items_path(tag_ids: [ tagging.tag.id ]) %>
            <%= link_to item_tagging_path(@item, tagging),
                  class: "hover:opacity-60",
                  data: { turbo_method: :delete, turbo_confirm: "Remove ##{tagging.tag.name}?" } do %>
              <%= icon "x", class: "size-3" %>
            <% end %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to "Edit", edit_item_path(@item), class: "btn btn-ghost" %>
</header>

<section class="card mt-8 bg-base-100 shadow-sm" data-controller="dropzone">
  <div class="card-body">
    <h2 class="card-title">Attachments</h2>

    <%= form_with url: item_attachments_path(@item), scope: :item, method: :post do |form| %>
      <%= form.file_field :attachments, multiple: true, direct_upload: true, data: { dropzone_target: "fileInput" }, class: "hidden" %>
    <% end %>

    <div data-dropzone-target="dropArea"
         class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-base-300 bg-base-200/40 p-8 text-center transition-colors hover:border-base-400">
      <%= icon "cloud-upload", class: "size-8 text-base-content/40" %>
      <span class="text-sm text-base-content/60">Drop files here, or click to browse</span>
    </div>

    <% if @item.attachments.any? %>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        <% @item.attachments.each do |attachment| %>
          <li class="group relative">
            <% if attachment_is_image?(attachment) %>
              <%= link_to image_tag(attachment.variant(:thumb), class: "aspect-square w-full rounded-lg object-cover transition-opacity hover:opacity-90"), url_for(attachment), target: "_blank", rel: "noopener" %>
            <% else %>
              <%= link_to url_for(attachment), target: "_blank", rel: "noopener", class: "flex aspect-square w-full flex-col items-center justify-center gap-2 rounded-lg bg-base-200 p-3 transition-opacity hover:opacity-90" do %>
                <%= attachment_icon(attachment) %>
                <span class="w-full truncate text-center text-xs text-base-content/60"><%= attachment.filename %></span>
              <% end %>
            <% end %>

            <%= button_to item_attachment_path(@item, attachment), method: :delete,
                  class: "absolute right-1 top-1 z-10 btn btn-circle btn-xs btn-error opacity-0 transition-opacity group-hover:opacity-100",
                  form: { data: { turbo_confirm: "Remove #{attachment.filename}?" } } do %>
              <%= icon "x", class: "size-3" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>

<section class="card mt-8 bg-base-100 shadow-sm">
  <div class="card-body">
    <div class="flex items-center justify-between gap-4">
      <h2 class="card-title">Events</h2>
      <%= link_to "+ Event", new_item_event_path(@item), class: "btn btn-primary" %>
    </div>

    <% if @events.any? %>
      <ul class="divide-y divide-base-300">
        <% @events.each do |event| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-3 first:pt-0 last:pb-0">
            <span class="badge badge-ghost"><%= event.kind.humanize %></span>
            <span class="flex items-center gap-2">
              <% if event.kind == "due_date" && @item.overdue? && event.at == @item.due_at %>
                <span class="badge badge-error">Overdue</span>
              <% end %>
              <time datetime="<%= event.at&.iso8601 %>"><%= event.at&.to_fs(:long) %></time>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-base-content/60">No events. Use + Event to add one.</p>
    <% end %>
  </div>
</section>

<section class="card mt-8 bg-base-100 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Audit trail</h2>

    <ul class="timeline timeline-vertical timeline-compact mt-2">
      <li>
        <div class="timeline-middle text-warning">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="timeline-end timeline-box">
          <p class="font-medium">Created as <span class="badge badge-warning">pending</span></p>
          <p class="text-sm text-base-content/60">by <%= @item.creator.email %></p>
          <time class="mt-1 block text-sm text-base-content/60" datetime="<%= @item.created_at.iso8601 %>"><%= @item.created_at.to_fs(:long) %></time>
        </div>
        <% if @transitions.any? %><hr><% end %>
      </li>

      <% @transitions.each_with_index do |transition, index| %>
        <li>
          <hr>
          <div class="timeline-middle <%= transition.to == "completed" ? "text-success" : "text-base-content/40" %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="timeline-end timeline-box">
            <p class="font-medium">
              Changed from <span class="badge badge-ghost"><%= transition.from %></span> to
              <span class="badge <%= transition.to == "completed" ? "badge-success" : transition.to == "seen" ? "badge-info" : "badge-ghost" %>"><%= transition.to %></span>
            </p>
            <p class="text-sm text-base-content/60">by <%= transition.user.email %></p>
            <time class="mt-1 block text-sm text-base-content/60" datetime="<%= transition.created_at.iso8601 %>"><%= transition.created_at.to_fs(:long) %></time>
          </div>
          <% unless index == @transitions.size - 1 %><hr><% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
