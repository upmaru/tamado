<nav class="menu w-full gap-1">
  <div class="menu-title">Projects</div>
  <% if @sidebar_projects.empty? %>
    <span class="menu-item opacity-50">No projects</span>
  <% else %>
    <% @sidebar_projects.each do |project| %>
      <%= link_to project.name, project_path(project), class: project == @project ? "active" : "" %>
    <% end %>
  <% end %>
</nav>
