<div class="mx-auto mt-10 w-full max-w-sm">
  <header class="text-center">
    <h1 class="text-3xl font-bold tracking-tight">Log in</h1>
    <p class="mt-2 text-base-content/60">Welcome back to Tamado.</p>
  </header>

  <div class="card mt-8 bg-base-100 shadow-sm">
    <div class="card-body">
      <%= form_with url: auth_sessions_path, scope: :session, class: "space-y-3" do |form| %>
        <%= form.email_field :email, class: "input input-bordered w-full", placeholder: "Email", required: true, autocomplete: "email", autofocus: true %>
        <%= form.password_field :password, class: "input input-bordered w-full", placeholder: "Password", required: true, autocomplete: "current-password" %>
        <%= form.submit "Log in", class: "btn btn-primary w-full" %>
      <% end %>

      <p class="mt-4 text-center text-sm text-base-content/60">
        Don't have an account?
        <%= link_to "Sign up", new_auth_registration_path, class: "link link-primary" %>
      </p>
    </div>
  </div>
</div>
