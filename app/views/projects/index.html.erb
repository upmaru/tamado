<header class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
    <p class="mt-2 text-base-content/60">Choose a project to see its lists and items.</p>
  </div>

  <%= link_to "+ Project", new_project_path, class: "btn btn-primary" %>
</header>

<% if @projects.empty? %>
  <div class="card mt-8 bg-base-100 shadow-sm">
    <div class="card-body text-base-content/60">No projects yet. Use + Project to create your first one.</div>
  </div>
<% else %>
  <ul class="card mt-8 divide-y divide-base-300 overflow-hidden bg-base-100 shadow-sm">
    <% @projects.each do |project| %>
      <li>
        <%= link_to project_path(project), class: "flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-base-200" do %>
          <span class="font-medium"><%= project.name %></span>
          <span class="badge badge-ghost"><%= project.lists.size %> lists</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
