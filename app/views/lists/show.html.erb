<nav class="text-sm opacity-60">
  <%= link_to @project.name, project_path(@project), class: "hover:opacity-100" %>
  <span>/</span>
  <span><%= @list.name %></span>
</nav>
<h1 class="mt-1 text-2xl font-bold"><%= @list.name %></h1>

<% if @items.empty? %>
  <p class="mt-4 opacity-60">No items in this list yet.</p>
<% else %>
  <ul class="mt-4 divide-y divide-base-300">
    <% @items.each do |item| %>
      <li class="flex items-center justify-between p-3">
        <span class="<%= "line-through opacity-60" if item.completed? %>"><%= item.description %></span>
        <span class="badge <%= item.completed? ? "badge-success" : "badge-warning" %>"><%= item.current_state %></span>
      </li>
    <% end %>
  </ul>
<% end %>
