<!DOCTYPE html>
<html data-theme="bumblebee">
  <head>
    <title><%= content_for(:title) || "Tamado" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tamado">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Compiled Tailwind + daisyUI %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200 text-base-content">
    <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-4 py-6 sm:px-6 sm:py-10">
      <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3 sm:gap-4">
          <span class="text-lg font-bold tracking-tight">Tamado</span>
          <ul class="menu menu-horizontal bg-base-200 rounded-box">
            <li>
              <%= link_to projects_path, class: controller_name == "projects" ? "menu-active" : nil, aria: { label: "Projects" } do %>
                <%= icon "folder", class: "size-4" %>
              <% end %>
            </li>
            <li>
              <%= link_to items_path, class: controller_name == "items" ? "menu-active" : nil, aria: { label: "Items" } do %>
                <%= icon "list-checks", class: "size-4" %>
              <% end %>
            </li>
          </ul>
        </div>
        <div class="flex items-center gap-2">
          <% if current_user %>
            <span class="hidden text-sm text-base-content/60 sm:inline"><%= current_user.email %></span>
            <%= button_to "Sign out", auth_logout_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          <% else %>
            <%= link_to "Log in", new_auth_session_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "Sign up", new_auth_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </header>

      <% if flash.notice %>
        <div role="alert" class="mb-6 alert alert-success">
          <span><%= flash.notice %></span>
        </div>
      <% end %>
      <% if flash.alert %>
        <div role="alert" class="mb-6 alert alert-error">
          <span><%= flash.alert %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
